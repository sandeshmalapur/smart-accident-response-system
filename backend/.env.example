# --- Database ---
# Local dev (docker-compose postgres service)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_accident_db
# Sync URL used by Alembic (asyncpg driver isn't used for migrations)
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/smart_accident_db

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- MQTT ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=safe-backend
MQTT_KEEPALIVE=60

# --- App ---
APP_ENV=local
CORS_ORIGINS=http://localhost:5173
